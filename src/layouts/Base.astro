---
import '../styles/site.css';
import { COPY } from '../lib/ui.ts';
import { type Locale, localePrefix } from '../lib/locales.ts';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Path after the locale prefix, e.g. "/energy". Drives hreflang and the switch. */
  path: string;
  current?: 'indicators' | 'search' | 'method' | 'corrections' | 'about';
  /** Share-card slug, for indicator pages. */
  ogSlug?: string;
}

const { locale, title, description, path, current, ogSlug } = Astro.props;
const c = COPY[locale];
const other: Locale = locale === 'en' ? 'hi' : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (l: Locale, p: string) => `${base}${localePrefix(l)}${p}` || '/';

/* One family across both scripts for display; the text face swaps by locale so
   an English page never downloads Devanagari. Tiro carries the Latin companion,
   so it stays loaded in both. */
const fonts = [
  'family=Tiro+Devanagari+Hindi:ital@0;1',
  locale === 'hi' ? 'family=Anek+Devanagari:wght@100..800' : 'family=Anek+Latin:wght@100..800',
  'family=Martian+Mono:wght@300..700',
].join('&');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === c.siteName ? title : `${title} — ${c.siteName}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline>
      // Runs before paint: a stored choice must be applied before the first
      // frame, or the page flashes the system scheme and then corrects itself.
      try {
        const saved = localStorage.getItem('antar-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) { /* private mode, or storage blocked: fall back to the system scheme */ }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
    <link rel="alternate" hreflang="en" href={href('en', path)} />
    <link rel="alternate" hreflang="hi" href={href('hi', path)} />
    <link rel="canonical" href={href(locale, path)} />
    <link rel="alternate" type="application/rss+xml" title="Antar" href={`${base}/rss.xml`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {ogSlug && <meta property="og:image" content={`${Astro.site ?? ''}${base}/og/${ogSlug}.png`.replace(/([^:])\/\//g, '$1/')} />}
    {ogSlug && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#8E2F6B" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="masthead">
        {/* Devanagari leads in both locales — the English page does not flip the
            lockup. The rule between the scripts is the same dimension-line
            device the site uses for the promise window. */}
        <a class="mark" href={href(locale, '')} aria-label={c.siteName}>
          <span class="deva">अंतर</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="latin">Antar</span>
        </a>
        <nav aria-label="Sections">
          <a href={href(locale, '')} aria-current={current === 'indicators' ? 'page' : undefined}>{c.navIndicators}</a>
          <a href={href(locale, '/search')} aria-current={current === 'search' ? 'page' : undefined}>{c.navSearch}</a>
          <a href={href(locale, '/method')} aria-current={current === 'method' ? 'page' : undefined}>{c.navMethod}</a>
          <a href={href(locale, '/corrections')} aria-current={current === 'corrections' ? 'page' : undefined}>{c.navCorrections}</a>
          <a href={href(locale, '/about')} aria-current={current === 'about' ? 'page' : undefined}>{c.navAbout}</a>
        </nav>
        <span class="spacer"></span>
        <button type="button" class="lang theme" id="theme" hidden
                data-label={c.themeLabel} data-system={c.themeSystem}
                data-light={c.themeLight} data-dark={c.themeDark}></button>
        <a class="lang" href={href(other, path)} hreflang={other} lang={other}>{c.otherLocale}</a>
      </header>

      <main id="main" data-pagefind-body>
        <slot />
      </main>

      <footer class="site">
        {c.footer}<br />
        <a href="https://github.com/nishtha2403/antar-data">antar-data</a> ·
        <a href="https://github.com/nishtha2403/antar-ingest">antar-ingest</a> ·
        <a href="https://github.com/nishtha2403/antar">antar</a>
      </footer>
    </div>

    <script is:inline>
      // Three states, not two: "system" is the default and has to remain
      // reachable, because following the reader's own setting is the correct
      // behaviour and a two-way switch would strand them out of it.
      (() => {
        const button = document.getElementById('theme');
        if (!button) return;
        const names = { system: button.dataset.system, light: button.dataset.light, dark: button.dataset.dark };
        const order = ['system', 'light', 'dark'];
        const read = () => {
          try { return localStorage.getItem('antar-theme') ?? 'system'; } catch { return 'system'; }
        };
        const paint = (mode) => {
          if (mode === 'system') document.documentElement.removeAttribute('data-theme');
          else document.documentElement.setAttribute('data-theme', mode);
          button.textContent = names[mode];
          // The accessible name has to carry the state. A fixed aria-label
          // overrides the visible text, so a screen reader would hear the
          // control's purpose and never which setting is active.
          button.setAttribute('aria-label', button.dataset.label + ': ' + names[mode]);
        };
        paint(read());
        button.hidden = false;
        button.addEventListener('click', () => {
          const next = order[(order.indexOf(read()) + 1) % order.length];
          try { localStorage.setItem('antar-theme', next); } catch { /* nothing to persist to */ }
          paint(next);
        });
      })();
    </script>
  </body>
</html>
